# Copia este archivo como `.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore: NUNCA se sube al repositorio.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# Clave secreta del servidor. No la compartas ni la pegues en el navegador.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# --- Panel del equipo organizador ---
# PIN para entrar a /admin. Cámbialo por uno propio antes del evento.
ADMIN_PIN="123456"

# --- URL pública del sitio (se usa para armar el QR del ticket) ---
# En local: http://localhost:3000 · En producción: https://eduticket.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
